#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>

// Layer indices
#define BASE  0
#define NAV   1
#define MOUSE 2
#define MEDIA 3
#define NUM   4
#define SYM   5
#define FUN   6

// macOS clipboard shortcuts (change LG to LC for Linux/Windows)
#define U_UNDO LG(Z)
#define U_REDO LG(LS(Z))
#define U_CUT  LG(X)
#define U_COPY LG(C)
#define U_PSTE LG(V)

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_caps {
            timeout-ms = <50>;
            key-positions = <13 16>;
            bindings = <&kp CAPS>;
            layers = <BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp SQT       &kp COMMA     &kp DOT       &kp P         &kp Y          &kp F        &kp G         &kp C         &kp R        &kp L
&hm LCTRL A   &hm LALT O    &hm LGUI E    &hm LSHFT U   &kp I          &kp D        &hm RSHFT H   &hm RGUI T    &hm RALT N   &hm RCTRL S
&kp FSLH      &kp Q         &kp J         &kp K         &kp X          &kp B        &kp M         &kp W         &kp V        &kp Z
                            &lt MEDIA ESC &lt NUM SPACE &lt SYM TAB    &lt MOUSE RET &lt NAV BSPC  &lt FUN DEL
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&kp PG_UP  &kp END    &kp UP      &kp HOME    &kp INS      &kp U_REDO   &kp U_PSTE  &kp U_COPY  &kp U_CUT   &kp U_UNDO
&kp PG_DN  &kp RIGHT  &kp DOWN    &kp LEFT    &caps_word   &none        &kp RSHFT   &kp RGUI    &kp RALT    &kp RCTRL
&kp U_UNDO &kp U_CUT  &kp U_COPY  &kp U_PSTE  &kp U_REDO   &none        &none       &none       &none       &none
                      &kp DEL     &kp BSPC    &kp RET      &none        &none       &none
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&msc SCRL_DOWN  &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT &none        &kp U_REDO   &kp U_PSTE      &kp U_COPY      &kp U_CUT  &kp U_UNDO
&msc SCRL_UP    &mmv MOVE_RIGHT &mmv MOVE_DOWN  &mmv MOVE_LEFT  &none        &none        &kp RSHFT       &kp RGUI        &kp RALT   &kp RCTRL
&kp U_UNDO      &kp U_CUT       &kp U_COPY      &kp U_PSTE      &kp U_REDO   &none        &none           &none           &none      &none
                                &mkp MB3        &mkp MB1        &mkp MB2     &none        &none           &none
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
&bootloader &none      &none       &none       &none        &none          &none          &none          &none          &soft_off
&kp LCTRL   &kp LALT   &kp LGUI    &kp LSHFT   &none        &none          &kp C_PREV     &kp C_VOL_DN   &kp C_VOL_UP   &kp C_NEXT
&none       &none      &none       &none       &none        &out OUT_TOG   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3
                       &none       &none       &none        &kp C_STOP     &kp C_PP       &kp C_MUTE
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&none      &none      &none       &none       &none        &kp RBKT    &kp N9      &kp N8      &kp N7     &kp LBKT
&kp LCTRL  &kp LALT   &kp LGUI    &kp LSHFT   &none        &kp EQUAL   &kp N6      &kp N5      &kp N4     &kp SEMI
&none      &none      &none       &none       &none        &kp BSLH    &kp N3      &kp N2      &kp N1     &kp GRAVE
                      &none       &none       &none        &kp MINUS   &kp N0      &kp DOT
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&none      &none      &none       &none       &none        &kp RBRC    &kp LPAR    &kp ASTRK   &kp AMPS   &kp LBRC
&kp LCTRL  &kp LALT   &kp LGUI    &kp LSHFT   &none        &kp PLUS    &kp CARET   &kp PRCNT   &kp DLLR   &kp COLON
&none      &none      &none       &none       &none        &kp PIPE    &kp HASH    &kp AT      &kp EXCL   &kp TILDE
                      &none       &none       &none        &kp UNDER   &kp RPAR    &kp LPAR
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
&kp F12    &kp F7     &kp F8      &kp F9      &kp PSCRN        &none       &none       &none       &none      &none
&kp F11    &kp F4     &kp F5      &kp F6      &kp SLCK         &none       &kp RSHFT   &kp RGUI    &kp RALT   &kp RCTRL
&kp F10    &kp F1     &kp F2      &kp F3      &kp PAUSE_BREAK  &none       &none       &none       &none      &none
                      &kp K_APP   &kp SPACE   &kp TAB          &none       &none       &none
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
