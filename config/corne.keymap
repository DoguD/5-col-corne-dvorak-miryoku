#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>

// Layer indices
#define BASE  0
#define NAV   1
#define MOUSE 2
#define MEDIA 3
#define NUM   4
#define SYM   5
#define FUN   6

// macOS clipboard shortcuts (change LG to LC for Linux/Windows)
#define U_UNDO LG(Z)
#define U_REDO LG(LS(Z))
#define U_CUT  LG(X)
#define U_COPY LG(C)
#define U_PSTE LG(V)

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    behaviors {
        // Positional homerow mods: only trigger as mod when paired with a
        // key on the OPPOSITE hand. Stops same-hand rolls (e.g. typing
        // "as", "th") from misfiring as Ctrl/Alt/GUI/Shift.
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <
                5  6  7  8  9
                15 16 17 18 19
                25 26 27 28 29
                33 34 35
            >;
            bindings = <&kp>, <&kp>;
        };
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <
                0  1  2  3  4
                10 11 12 13 14
                20 21 22 23 24
                30 31 32
            >;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_caps {
            timeout-ms = <50>;
            key-positions = <13 16>;
            bindings = <&kp CAPS>;
            layers = <BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp SQT       &kp COMMA     &kp DOT       &kp P         &kp Y          &kp F        &kp G         &kp C         &kp R        &kp L
&hml LCTRL A  &hml LALT O   &hml LGUI E   &hml LSHFT U  &kp I          &kp D        &hmr RSHFT H  &hmr RGUI T   &hmr RALT N  &hmr RCTRL S
&kp FSLH      &kp Q         &kp J         &kp K         &kp X          &kp B        &kp M         &kp W         &kp V        &kp Z
                            &lt MEDIA ESC &lt NUM SPACE &lt SYM TAB    &lt MOUSE RET &lt NAV BSPC  &lt FUN DEL
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&kp INS    &kp HOME   &kp UP      &kp END     &kp PG_UP    &none        &none       &none       &none       &none
&caps_word &kp LEFT   &kp DOWN    &kp RIGHT   &kp PG_DN    &none        &kp RSHFT   &kp RGUI    &kp RALT    &kp RCTRL
&kp U_UNDO &kp U_CUT  &kp U_COPY  &kp U_PSTE  &kp U_REDO   &kp U_REDO   &kp U_PSTE  &kp U_COPY  &kp U_CUT   &kp U_UNDO
                      &kp RET     &kp BSPC    &kp DEL      &none        &none       &none
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&none           &msc SCRL_RIGHT &mmv MOVE_UP    &msc SCRL_LEFT  &msc SCRL_DOWN  &none        &none           &none           &none      &none
&none           &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT &msc SCRL_UP    &none        &kp RSHFT       &kp RGUI        &kp RALT   &kp RCTRL
&kp U_UNDO      &kp U_CUT       &kp U_COPY      &kp U_PSTE      &kp U_REDO      &kp U_REDO   &kp U_PSTE      &kp U_COPY      &kp U_CUT  &kp U_UNDO
                                &mkp MB2        &mkp MB1        &mkp MB3        &none        &none           &none
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
&bootloader &none      &none       &none       &none        &none          &none          &none          &none          &soft_off
&kp LCTRL   &kp LALT   &kp LGUI    &kp LSHFT   &none        &none          &kp C_PREV     &kp C_VOL_DN   &kp C_VOL_UP   &kp C_NEXT
&none       &none      &none       &none       &none        &out OUT_TOG   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3
                       &none       &none       &none        &kp C_STOP     &kp C_PP       &kp C_MUTE
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&none      &none      &none       &none       &none        &kp LBKT    &kp N7      &kp N8      &kp N9     &kp RBKT
&kp LCTRL  &kp LALT   &kp LGUI    &kp LSHFT   &none        &kp SEMI    &kp N4      &kp N5      &kp N6     &kp EQUAL
&none      &none      &none       &none       &none        &kp GRAVE   &kp N1      &kp N2      &kp N3     &kp BSLH
                      &none       &none       &none        &kp MINUS   &kp N0      &kp DOT
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&none      &none      &none       &none       &none        &kp LBRC    &kp AMPS    &kp ASTRK   &kp LPAR   &kp RBRC
&kp LCTRL  &kp LALT   &kp LGUI    &kp LSHFT   &none        &kp COLON   &kp DLLR    &kp PRCNT   &kp CARET  &kp PLUS
&none      &none      &none       &none       &none        &kp TILDE   &kp EXCL    &kp AT      &kp HASH   &kp PIPE
                      &none       &none       &none        &kp UNDER   &kp LPAR    &kp RPAR
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
&kp F12    &kp F7     &kp F8      &kp F9      &kp PSCRN        &none       &none       &none       &none      &none
&kp F11    &kp F4     &kp F5      &kp F6      &kp SLCK         &none       &kp RSHFT   &kp RGUI    &kp RALT   &kp RCTRL
&kp F10    &kp F1     &kp F2      &kp F3      &kp PAUSE_BREAK  &none       &none       &none       &none      &none
                      &kp K_APP   &kp SPACE   &kp TAB          &none       &none       &none
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
